{
  "name": "camoo/framework",
  "description": "CAMOO Framework",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "vlucas/valitron": "^1.4",
    "ext-mbstring": "*",
    "ext-json": "*",
    "middlewares/request-handler": "^v2.0.0",
    "middlewares/fast-route": "^v2.0.0",
    "nikic/fast-route": "^v1.3.0",
    "twig/twig": "^v3.5.0",
    "filp/whoops": "^2.7",
    "symfony/var-dumper": "^4.0 || ^5.0 || ^6.0 || ^7.0",
    "hassankhan/config": "^2.1 || ^3.0",
    "symfony/yaml": "^4.0 || ^5.0 || ^6.0 || ^7.0",
    "symfony/cache": "^5.3 || ^6.0 || ^7.0",
    "doctrine/orm": "^2.6 || ^3.0",
    "cakephp/orm": "^3.8 || ^4.0 || ^5.0",
    "cakephp/i18n": "^3.8 || ^4.0 || ^5.0",
    "cakephp/log": "^3.8 || ^4.0 || ^5.0",
    "aura/session": "^2.1",
    "nyholm/psr7": "^1.2",
    "ircmaxell/random-lib": "^1.2",
    "squizlabs/php_codesniffer": "^3.2",
    "http-interop/http-factory-discovery": "^1.5",
    "overclokk/cookie": "^1.0",
    "symfony/console": "^5.1 || ^6.0 || ^7.0",
    "nette/mail": "^v3.0",
    "jms/serializer": "^3.9",
    "camoo/curl-http-client": "^1.0",
    "camoo/cache": "^2.1",
    "camoo/inflector": "^1.1",
    "ray/di": "^2.15",
    "guzzlehttp/guzzle": "^7.5",
    "doctrine/cache": "^2.0",
    "ray/compiler": "^1.16"
  },
  "minimum-stability": "dev",
  "homepage": "https://camoo.cm",
  "license": "MIT",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "rector/rector": "^2.0"
  },
  "authors": [
    {
      "name": "CAMOO SARL",
      "email": "framework@camoo.sarl"
    }
  ],
  "keywords": [
    "CAMOO",
    "Framework",
    "PHP OpenSource"
  ],
  "autoload": {
    "psr-4": {
      "CAMOO\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CAMOO\\Test\\": "tests"
    }
  },
  "suggest": {
    "phpunit/phpunit": "Allows automated tests to be run without system-wide install."
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "support": {
    "issues": "https://gitlab.com/camoo/framework/issues",
    "source": "https://gitlab.com/camoo/framework"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
